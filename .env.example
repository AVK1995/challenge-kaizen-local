# ═══════════════════════════════════════════════════════════════════════════
#  Kaizen · 5-Day (Peri)Menopause Reset · FREE registration funnel (Dubai)
#
#  Copy to .env.local and fill in. Every value below is read somewhere in the
#  code — nothing here is aspirational.
#
#  Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
#  readable by anyone. Never put a secret behind that prefix.
#
#  The app degrades quietly when these are missing: routes check their own
#  config and skip rather than posting to a dead endpoint. So a half-filled
#  file will not crash the site, it will just silently not track or not store
#  leads.
# ═══════════════════════════════════════════════════════════════════════════


# ── 1 · SITE ───────────────────────────────────────────────────────────────
# The live origin, no trailing slash. Used as the fallback event_source_url
# for Meta. e.g. https://kaizen.example.com
NEXT_PUBLIC_SITE_URL=


# ── 1b · THE OFFER ─────────────────────────────────────────────────────────
# Everything below is read by app/_landing/offer.ts and flows to EVERY screen
# that shows it. Every key is OPTIONAL: leave one blank and the code falls back
# to the value shown in its comment.
#
# These are build-time values (NEXT_PUBLIC_*), so changing one in Vercel needs
# a redeploy to take effect. No code change, no PR.

# When the cohort starts, written the way it is read aloud.
# Default: 9th October
NEXT_PUBLIC_START_DATE=

# The daily session timings. Normally you only set the first one; the other two
# are derived from it so they cannot fall out of step.
#   SESSION_TIMES        pills, bands, footer           Default: 6:30 AM & 7 PM
#   ..._PROSE            prose + meta description       Derived: "&" → "and"
#   ..._TZ               modal, legal, thank-you        Derived: "&" → "or", + IST
# ⚠️ DUBAI: the derived _TZ says IST. Set it explicitly if the sessions are
#   advertised in Gulf time, e.g. "5 AM or 5:30 PM GST".
NEXT_PUBLIC_SESSION_TIMES=
NEXT_PUBLIC_SESSION_TIMES_PROSE=
NEXT_PUBLIC_SESSION_TIMES_TZ=

# The announcement bar's scarcity line: "Live batches capped at 60 women ·
# 23 seats left". ⚠️ SEATS_LEFT is a real number someone has to keep current.
# Defaults: 60 and 23
NEXT_PUBLIC_SEATS_CAP=
NEXT_PUBLIC_SEATS_LEFT=

# The figure in the trust ledger and the hero credential card.
# Default: 540+
NEXT_PUBLIC_WOMEN_SUPPORTED=

# The WhatsApp community invite link. The thank-you page makes joining it the
# single next step after registering, so without this a new registrant sees
# "your invite is on its way" instead of a join button. REQUIRED BEFORE LAUNCH.
NEXT_PUBLIC_WHATSAPP_INVITE=


# ── 2 · META ───────────────────────────────────────────────────────────────
# The same pixel id twice, deliberately: one copy is compiled into the browser
# for PageView and the pixel half of atc_event / registration_complete, the
# other stays server-side for the Conversions API.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=

# Events Manager → your dataset → Settings → Conversions API → Generate access
# token. Server-side only. Carries ViewContent, atc_event and
# registration_complete.
META_CAPI_ACCESS_TOKEN=

# Optional, for verification only. Events Manager → Test Events. REMOVE THIS
# BEFORE LAUNCH: events sent with a test code do not count toward optimisation,
# and while it is set every Pabbly record is sent with is_test: true.
META_CAPI_TEST_EVENT_CODE=


# ── 3 · GA4 ────────────────────────────────────────────────────────────────
# Admin → Data Streams → your web stream. Format G-XXXXXXXXXX.
# Sends view_item, add_to_cart (modal opened) and generate_lead (registered).
NEXT_PUBLIC_GA4_ID=


# ── 4 · CLARITY ────────────────────────────────────────────────────────────
# clarity.microsoft.com → your project → Settings → the id in the tag snippet.
# Session replay and heatmaps. Renders nothing when empty.
NEXT_PUBLIC_CLARITY_ID=


# ── 5 · PABBLY ─────────────────────────────────────────────────────────────
# Pabbly Connect → your workflow → the Webhook trigger's URL.
# This is the LEAD hand-off: it is what tells the automation who registered,
# so they receive the WhatsApp invite, the joining details and the guides.
# Fired from /api/register on every free registration.
#
# The payload is FLAT and every key is present on every call, empty where
# unknown, because Pabbly builds its field mapper from the first payload it
# sees and a key that is merely absent then cannot be mapped later:
#   event ("free_registration"), funnel ("dubai_free"), product, lead_id,
#   created_at, first_name, last_name, name, email, phone, city, country_code,
#   occupation, fbc, fbp, client_ip_address, client_user_agent, external_id,
#   event_source_url, is_test, registration_event_id, utm_source, utm_medium,
#   utm_campaign, utm_content, utm_term, fbclid, referrer, landing_url,
#   geo_country, geo_city.
# `is_test` is a real boolean, true whenever META_CAPI_TEST_EVENT_CODE is set —
# route those away from the live WhatsApp invite.
PABBLY_WEBHOOK_URL=

# ═══════════════════════════════════════════════════════════════════════════
#  NOT env, but still required before launch:
#
#  1. The hero art and the mobile coaches banner still have "₹497" baked into
#     the image. Re-cut them for the free offer.
#  2. app/_landing/legal.ts — check the operator details are correct.
# ═══════════════════════════════════════════════════════════════════════════
